  <bpmn:process id="Process_08_quan_ly_nha_cung_cap" name="8. QUẢN LÝ NHÀ CUNG CẤP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu" />
    <bpmn:endEvent id="EndEvent_1" name="Kết thúc" />
    <bpmn:task id="Task_1" name="Bắt đầu / nhà cung cấp gửi báo giá và hồ sơ" />
    <bpmn:exclusiveGateway id="Gateway_2" name="Hai bên thống nhất điều khoản?" />
    <bpmn:task id="Task_3" name="Ký kết hợp đồng, cáp kết hợp đồng" />
    <bpmn:task id="Task_4" name="Điều chỉnh đề xuất mua hàng" />
    <bpmn:task id="Task_5" name="Theo dõi chất lượng, tiến độ và đánh giá định kỳ" />
    <bpmn:task id="Task_6" name="Xác định nhà cung cấp" />
    <bpmn:task id="Task_7" name="Lập đề xuất lựa chọn nhà cung cấp" />
    <bpmn:task id="Task_8" name="Kết thúc / tiếp tục hợp tác" />
    <bpmn:exclusiveGateway id="Gateway_9" name="Ban giám đốc phê duyệt?" />
    <bpmn:task id="Task_10" name="Bắt đầu / phát sinh nhu cầu mua" />
    <bpmn:task id="Task_11" name="Điều chỉnh điều khoản / đàm phán lại" />
    <bpmn:task id="Task_12" name="Đánh giá giá cả, chất lượng, năng lực và điều kiện hợp tác" />
    <bpmn:exclusiveGateway id="Gateway_13" name="Đạt tiêu chí đánh giá?" />
    <bpmn:task id="Task_14" name="Loại / yêu cầu bổ sung hoặc tìm nhà cung cấp khác" />
    <bpmn:task id="Task_15" name="Tìm kiếm, khảo sát nhà cung cấp mới" />
    <bpmn:task id="Task_16" name="Yêu cầu báo giá, hồ sơ năng lực và pháp lý" />
